# The zero-configuration demo runs without this file. Copy to .env for stable settings.
# Generate your own secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
POSTGRES_DB=babal
POSTGRES_USER=babal
POSTGRES_PASSWORD=
POSTGRES_HOST_AUTH_METHOD=trust
DEMO_MODE=1
SEED_DEMO=1
HTTP_BIND=127.0.0.1
HTTP_PORT=8000
DEFAULT_TSHIRT_PRICE=1200
DEFAULT_DELIVERY_FEE=150
COOKIE_SECURE=0
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
